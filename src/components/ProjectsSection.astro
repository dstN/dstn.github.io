---
import { projects, featured, shipped } from "../data/projects";
import ProjectShot from "./ProjectShot.astro";
import ProjectLinks from "./ProjectLinks.astro";

const total = projects.length;
---

<section id="projects" class="section">
  <div class="w-wide">
    <div class="projects-head">
      <h2>Selected Work</h2>
      <a class="projects-index-link" href="/work/">
        All {total} projects
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="case-studies">
      {
        featured.map((project, i) => (
          <article class:list={["case", i % 2 === 1 && "case--reverse"]}>
            <div class="case-content">
              <h3 class="case-name">
                {project.name}
                <span class="featured-dot" aria-hidden="true" />
              </h3>
              <p class="case-summary">{project.summary}</p>
              {project.proof && <p class="case-proof">{project.proof}</p>}
              <p class="case-stack">{project.stack.join(" · ")}</p>
              <ProjectLinks project={project} size="md" />
            </div>
            <div class="case-visual">
              {project.shot && (
                <ProjectShot slug={project.slug} frame={project.shot.frame} alt={project.shot.alt} variant="feature" />
              )}
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="projects-subhead" id="shipped">Also shipped</h3>

    <div class="project-list">
      {
        shipped.map((project) => (
          <article class="project-row">
            <div class="project-row-visual">
              {project.shot && (
                <ProjectShot slug={project.slug} frame={project.shot.frame} alt={project.shot.alt} variant="thumb" />
              )}
            </div>
            <div class="project-row-text">
              <h4 class="project-name">{project.name}</h4>
              <p class="project-desc">{project.pitch}</p>
              <p class="project-stack">{project.stack.join(" · ")}</p>
            </div>
            <ProjectLinks project={project} />
          </article>
        ))
      }
    </div>

    <a class="projects-footer-link" href="/work/">
      See the full index — {total} projects across web, mobile, tooling and CMS work
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>
