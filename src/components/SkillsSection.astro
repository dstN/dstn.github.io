---
const specs = [
	{
		label: 'Languages',
		value: 'TypeScript, JavaScript, HTML, CSS, PHP, Python',
		primaries: ['TypeScript', 'CSS'],
	},
	{
		label: 'Frameworks',
		value: 'Vue.js, Nuxt, Astro, SvelteKit, React, Next.js, NestJS',
		primaries: ['Vue.js', 'Nuxt', 'Astro'],
	},
	{
		label: 'Templating',
		value: 'Twig, MJML',
		primaries: [],
	},
	{
		label: 'Styling',
		value: 'Tailwind CSS, SASS, CSS Layers, oklch(), Container Queries, Bootstrap',
		primaries: ['Tailwind CSS', 'CSS Layers'],
	},
	{
		label: 'CMS',
		value: 'WordPress, Joomla, NEOS, Directus',
		primaries: [],
	},
	{
		label: 'Data',
		value: 'MySQL, MariaDB, Drizzle ORM, SQLAlchemy, SQLite, IndexedDB',
		primaries: ['Drizzle ORM', 'SQLite'],
	},
	{
		label: 'Testing',
		value: 'Vitest, Playwright, axe-core',
		primaries: ['Playwright', 'axe-core'],
	},
	{
		label: 'Tooling',
		value: 'Git, GitHub Actions, Vite, Webpack, Docker, DDEV, npm, Postman, Figma',
		primaries: ['Git', 'Vite'],
	},
	{
		label: 'Practices',
		value: 'Accessibility (WCAG 2.2), Privacy by Design, Responsive Design, SEO, CI/CD, REST APIs',
		primaries: ['Accessibility (WCAG 2.2)', 'Privacy by Design'],
	},
];

function renderValue(value: string, primaries: string[]): string {
	if (primaries.length === 0) return value;
	// Matched per list entry, not by substring: a plain replace would wrap the
	// "Git" inside "GitHub Actions" and corrupt the markup around it.
	return value
		.split(', ')
		.map((entry) => (primaries.includes(entry) ? `<span class="primary-tech">${entry}</span>` : entry))
		.join(', ');
}
---

<section id="skills" class="section">
	<div class="w-narrow">
		<h2>Stack</h2>
		<div class="spec-sheet" style="margin-top: var(--s-2xl);">
			{
				specs.map((s) => (
					<div class="spec-row">
						<div class="spec-label">{s.label}</div>
						<div class="spec-value" set:html={renderValue(s.value, s.primaries)} />
					</div>
				))
			}
		</div>
	</div>
</section>
